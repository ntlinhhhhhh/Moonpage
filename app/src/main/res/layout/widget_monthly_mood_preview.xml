<?xml version="1.0" encoding="utf-8"?>
<!-- Preview Widget 4: Monthly Mood (4×3) – Style DailyBean exact match with full grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/preview_theme_default_bg"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Header: ↻ | Nov 2025 | ⚙ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView android:id="@+id/mm_refresh"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentStart="true" android:layout_centerVertical="true"
            android:text="↻" android:textColor="#BBBBBB" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Nov 2025" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/mm_settings"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:text="⚙" android:textColor="#BBBBBB" android:textSize="13sp" />
    </RelativeLayout>

    <!-- Day header labels: Sun Mon The Wed Thu Fri Sat -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:weightSum="7" android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Sun" android:textSize="7sp" android:textColor="#AAAAAA"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Mon" android:textSize="7sp" android:textColor="#AAAAAA"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Tue" android:textSize="7sp" android:textColor="#AAAAAA"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Wed" android:textSize="7sp" android:textColor="#AAAAAA"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Thu" android:textSize="7sp" android:textColor="#AAAAAA"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Fri" android:textSize="7sp" android:textColor="#AAAAAA"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Sat" android:textSize="7sp" android:textColor="#AAAAAA"/>
    </LinearLayout>

    <!-- Week 1: [empty][empty][empty][empty][empty][empty][Sat=mood] -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:weightSum="7" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" />
        <!-- Sat 1 – has mood -->
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/mood_circle_bg_1"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/very_happy" android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Week 2: Sun–Sat all have mood -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:weightSum="7" android:gravity="center_vertical">
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_2"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/happy" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_4"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/sad" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_2"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/happy" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_3"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/neutral" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_1"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/very_happy" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_2"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/happy" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_3"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/neutral" android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Week 3: Mix mood + muted circle (no log) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:weightSum="7" android:gravity="center_vertical">
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_3"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/neutral" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_5"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/very_sad" android:scaleType="fitCenter"/>
        </FrameLayout>
        <!-- muted circle = no log -->
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/muted_circle_bg"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_4"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/sad" android:scaleType="fitCenter"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_5"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/very_sad" android:scaleType="fitCenter"/>
        </FrameLayout>
        <!-- muted circle -->
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/muted_circle_bg"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_1"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/very_happy" android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Week 4: Mix mood + muted + today dashed + future plain number -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:weightSum="7" android:gravity="center_vertical">
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/mood_circle_bg_1"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/very_happy" android:scaleType="fitCenter"/>
        </FrameLayout>
        <!-- Today: dashed circle + number "24" -->
        <FrameLayout android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/widget_day_today_border"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="24" android:textColor="#555555"
                android:textSize="8sp" android:textStyle="bold"/>
        </FrameLayout>
        <!-- Future: plain numbers -->
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="25" android:textColor="#CCCCCC" android:textSize="9sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="26" android:textColor="#CCCCCC" android:textSize="9sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="27" android:textColor="#CCCCCC" android:textSize="9sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="28" android:textColor="#CCCCCC" android:textSize="9sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="29" android:textColor="#CCCCCC" android:textSize="9sp"/>
    </LinearLayout>

    <!-- Week 5: Just "30" plain -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:weightSum="7" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="30" android:textColor="#CCCCCC" android:textSize="9sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="6" android:text=""/>
    </LinearLayout>

</LinearLayout>
